# Optional: copy this file to .env and edit settings.
PORT=3000
# PUBLIC_URL=https://your-game.example.com
# Set true only when the site is served over HTTPS.
COOKIE_SECURE=false
# PostgreSQL for hosted deployment (keep the actual value private).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# TRUST_PROXY=1
# Supabase server-side storage (preferred for hosted accounts and quizzes).
# Apply server/supabase-schema.sql in your Supabase project before starting.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# DATA_DIR=C:/frostbound-data
